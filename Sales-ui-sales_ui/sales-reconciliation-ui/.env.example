# Base URL of the backend API (no trailing slash, includes /api)
# Local dev default (matches the fallback already in code):
# VITE_API_URL=https://localhost:7276/api
#
# Production (after deploying the backend to Azure App Service):
# VITE_API_URL=https://<your-app-service-name>.azurewebsites.net/api
VITE_API_URL=https://localhost:7276/api
