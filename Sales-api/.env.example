DATABASE_URL="postgresql://user:password@localhost:5432/SalesReconciliation"

PORT=5000

JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ISSUER=SalesReconciliationApp
JWT_AUDIENCE=SalesReconciliationClient
JWT_EXPIRATION_MINUTES=1440

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://your-api-host/api/gmail/callback
GMAIL_SENDER_EMAIL=
GMAIL_FRONTEND_BASE_URL=http://localhost:5173

# ── Photo attachments ──
# Where uploaded photos are written. Relative paths resolve against the API's
# working directory; on the VPS this is an absolute path outside the git
# checkout so a redeploy never touches it. Must be backed up — the database
# alone will not restore the images.
UPLOAD_DIR=uploads
# Set only when nginx fronts the API, to the `internal` location that aliases
# UPLOAD_DIR. The API still authorises every request; nginx just sends the
# bytes. Leave blank locally and Node streams the file itself.
UPLOAD_ACCEL_REDIRECT=
