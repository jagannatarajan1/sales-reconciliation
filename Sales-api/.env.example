DATABASE_URL="postgresql://user:password@localhost:5432/SalesReconciliation"

PORT=5000

JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ISSUER=SalesReconciliationApp
JWT_AUDIENCE=SalesReconciliationClient
JWT_EXPIRATION_MINUTES=1440

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://your-api-host/api/gmail/callback
GMAIL_SENDER_EMAIL=
GMAIL_FRONTEND_BASE_URL=http://localhost:5173

# ── Shift handling ──
# Off by default: every entry lands in the legacy FULL_DAY bucket until this
# is explicitly switched on. See lib/activeDate.ts.
SHIFT_ENTRY_ENABLED=false
SHIFT_CUTOFF_TIME=17:00
SHOP_TIMEZONE=Europe/London

# ── Session photos ──
# "local" writes to PHOTO_UPLOAD_DIR. The storage layer (lib/storage) is
# driver-based so S3/R2/MinIO can be added without touching routes or schema.
PHOTO_STORAGE_DRIVER=local

# Dev default is relative; production MUST set an absolute path on a volume
# that survives redeploys, e.g. /var/lib/sales-reconciliation/uploads
PHOTO_UPLOAD_DIR=./uploads/session-photos

# Set to the nginx `internal` location to let nginx serve the bytes once the
# API has authorised (X-Accel-Redirect). Leave empty in dev — Node streams.
PHOTO_ACCEL_REDIRECT=

MAX_PHOTO_SIZE_MB=10
PHOTO_MAX_FILES_PER_REQUEST=10
PHOTO_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/heic
PHOTO_MAX_EDGE_PX=1600
PHOTO_THUMB_EDGE_PX=320
