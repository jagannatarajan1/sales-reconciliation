generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId       Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("user") // user or admin
  permissions  String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  isActive     Boolean  @default(true)

  orders           Order[]
  gmailConnections GmailConnection[]
  adminLoginOtps   AdminLoginOtp[]
}

// One row per pending/completed admin login OTP challenge. Only ever created
// for accounts with role "admin" — regular user logins never touch this
// table. The code itself is never stored, only its SHA-256 hash.
model AdminLoginOtp {
  adminLoginOtpId Int       @id @default(autoincrement())
  userId          Int
  sessionToken    String    @unique
  codeHash        String
  expiresAt       DateTime
  attempts        Int       @default(0)
  lastSentAt      DateTime  @default(now())
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  auditLogId    Int      @id @default(autoincrement())
  userId        Int?
  userName      String?
  action        String
  entity        String?
  entityId      String?
  previousValue String?
  newValue      String?
  createdAt     DateTime @default(now())
}

model Order {
  orderId     Int      @id @default(autoincrement())
  userId      Int
  orderNumber String
  orderDate   DateTime
  totalAmount Decimal  @db.Decimal(18, 2)
  status      String   @default("pending") // pending, completed, cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [userId])
}

model DailySummary {
  dailySummaryId Int      @id @default(autoincrement())
  date           DateTime @db.Date
  shift          Shift    @default(FULL_DAY)

  cashback             Decimal @default(0) @db.Decimal(18, 2)
  paypointPayout       Decimal @default(0) @db.Decimal(18, 2)
  instantLotteryPayout Decimal @default(0) @db.Decimal(18, 2)
  lotteryPayout        Decimal @default(0) @db.Decimal(18, 2)
  newsVoucher          Decimal @default(0) @db.Decimal(18, 2)
  ddPoint              Decimal @default(0) @db.Decimal(18, 2)
  lotteryValue         Decimal @default(0) @db.Decimal(18, 2)
  paypointValue        Decimal @default(0) @db.Decimal(18, 2)
  lastSafe             Decimal @default(0) @db.Decimal(18, 2)
  safeDropAmount       Decimal @default(0) @db.Decimal(18, 2)

  staffNotes String?

  // Who last touched this day's entry before it was committed, and when —
  // the "Last Edited By / At" audit trail shown on Uncommitted Data.
  // updatedAt already carries the "when" once committed data starts
  // supplying committedAt/committedByName instead, so this pair only ever
  // needs to answer "who edited the uncommitted figures".
  lastEditedByUserId Int?
  lastEditedByName   String?

  isCommitted          Boolean @default(false)
  isPendingAdminReview Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  creditCardEntries CreditCardEntry[]

  @@unique([date, shift])
}

model CreditCardEntry {
  creditCardEntryId Int      @id @default(autoincrement())
  manualCardAmount  Decimal  @default(0) @db.Decimal(18, 2)
  cardAmount        Decimal  @default(0) @db.Decimal(18, 2)
  createdDate       DateTime @default(now())

  dailySummaryId Int
  dailySummary   DailySummary @relation(fields: [dailySummaryId], references: [dailySummaryId], onDelete: Cascade)
}

model Deduction {
  deductionId Int      @id @default(autoincrement())
  date        DateTime @db.Date
  shift       Shift    @default(FULL_DAY)

  cashback             Decimal @default(0) @db.Decimal(18, 2)
  paypointPayout       Decimal @default(0) @db.Decimal(18, 2)
  instantLotteryPayout Decimal @default(0) @db.Decimal(18, 2)
  lotteryPayout        Decimal @default(0) @db.Decimal(18, 2)
  newsVoucher          Decimal @default(0) @db.Decimal(18, 2)
  ddPoint              Decimal @default(0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([date, shift])
}

model Supplier {
  supplierId Int      @id @default(autoincrement())
  name       String
  createdAt  DateTime @default(now())

  invoices SupplierInvoice[]
}

model SupplierInvoice {
  supplierInvoiceId Int      @id @default(autoincrement())
  date              DateTime @db.Date
  // Invoices arrive with deliveries, not shifts — this is a plain column
  // (no unique-constraint change) purely so a delivery can be attributed to
  // whichever shift was active when it was entered, consistent with the
  // other entry tables. createdAt already timestamps it precisely; this is
  // the coarser, shift-comparable label.
  shift             Shift    @default(FULL_DAY)
  supplierId        Int?
  supplierName      String
  invoiceNo         String
  value             Decimal  @db.Decimal(18, 2)
  enteredByUserId   Int?
  enteredByName     String?
  createdAt         DateTime @default(now())

  supplier Supplier? @relation(fields: [supplierId], references: [supplierId], onDelete: SetNull)
}

model ScratchCard {
  scratchCardId Int      @id @default(autoincrement())
  scratchCardNo String
  price         Decimal  @default(0) @db.Decimal(18, 2)
  isActive      Boolean  @default(true)
  forcedOpenNo  Int?
  // Unused — Stage 5 removed the pack-size/remaining-stock model in favour of
  // a simple Opening Value / Current Value carry-over (see
  // adminLottery.routes.ts). Column left in place rather than dropped.
  packSize      Int      @default(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  inventoryEntries InstantLotteryInventoryEntry[]
}

model InstantLotteryInventoryEntry {
  inventoryId   Int      @id @default(autoincrement())
  scratchCardId Int
  date          DateTime @db.Date
  shift         Shift    @default(FULL_DAY)
  openNo        Int      @default(0)
  closeNo       Int      @default(0)
  totalSold     Int      @default(0)
  sales         Decimal  @default(0) @db.Decimal(18, 2)
  createdDate   DateTime @default(now())

  scratchCard ScratchCard @relation(fields: [scratchCardId], references: [scratchCardId], onDelete: Cascade)

  @@unique([scratchCardId, date, shift])
}

model LotteryRecord {
  lotteryRecordId Int      @id @default(autoincrement())
  date            DateTime @db.Date
  shift           Shift    @default(FULL_DAY)
  lotteryValue    Decimal  @default(0) @db.Decimal(18, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@unique([date, shift])
}

model PaypointRecord {
  paypointRecordId Int      @id @default(autoincrement())
  date             DateTime @db.Date
  shift            Shift    @default(FULL_DAY)
  paypointValue    Decimal  @default(0) @db.Decimal(18, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@unique([date, shift])
}

model ReconciliationRecord {
  reconciliationRecordId Int      @id @default(autoincrement())
  date                   DateTime @unique @db.Date

  manualCardAmount         Decimal @default(0) @db.Decimal(18, 2)
  cardAmount               Decimal @default(0) @db.Decimal(18, 2)
  lastSafe                 Decimal @default(0) @db.Decimal(18, 2)
  safeDropAmount           Decimal @default(0) @db.Decimal(18, 2)
  cashback                 Decimal @default(0) @db.Decimal(18, 2)
  paypointPayout           Decimal @default(0) @db.Decimal(18, 2)
  instantLotteryPayout     Decimal @default(0) @db.Decimal(18, 2)
  lotteryPayout            Decimal @default(0) @db.Decimal(18, 2)
  newsVoucher              Decimal @default(0) @db.Decimal(18, 2)
  ddPoint                  Decimal @default(0) @db.Decimal(18, 2)
  supplierInvoicesTotal    Decimal @default(0) @db.Decimal(18, 2)
  instantLotteryTotalCount Int     @default(0)
  instantLotteryTotalSales Decimal @default(0) @db.Decimal(18, 2)
  lotteryValue             Decimal @default(0) @db.Decimal(18, 2)
  paypointValue            Decimal @default(0) @db.Decimal(18, 2)

  summaryTotal Decimal @default(0) @db.Decimal(18, 2)
  zReportTotal Decimal @default(0) @db.Decimal(18, 2)
  difference   Decimal @default(0) @db.Decimal(18, 2)
  adminNotes   String?

  staffNotes String?

  isStaffCommitted  Boolean @default(false)
  isAdminReconciled Boolean @default(false)

  committedByUserId Int?
  committedByName   String?
  committedAt       DateTime?

  adminSubmittedByUserId Int?
  adminSubmittedByName   String?
  adminSubmittedAt       DateTime?

  // End-of-day X_day + X_night vs Z check, using FINAL (admin-approved where
  // present, else staff-entered, else the till's original) shift totals —
  // never the raw till totals alone, so an admin correction that resolves a
  // shift variance also resolves this without a second alert. Nullable: a
  // date with no X-Reports behind it (anything predating this feature, or a
  // day the till simply didn't send one) reads as "not applicable" rather
  // than a false zero variance.
  xFinalDayTotal   Decimal? @db.Decimal(18, 2)
  xFinalNightTotal Decimal? @db.Decimal(18, 2)
  xFinalSumTotal   Decimal? @db.Decimal(18, 2)
  xVsZDifference   Decimal? @db.Decimal(18, 2) // signed: xFinalSumTotal − zReportTotal

  // De-dupe for the X-vs-Z alert, same purpose as ShiftReconciliation's
  // notifiedAt/notifiedDifference — without it the poller re-mails an
  // unchanged day-level variance every cycle.
  zNotifiedAt         DateTime?
  zNotifiedDifference Decimal?  @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// RESOLVED is distinct from OK only so the history shows *why* a shift
// passes (an admin corrected it) rather than it having been fine all along —
// both are treated identically as "in tolerance" everywhere this is
// evaluated (see lib/variance.ts's isWithinTolerance and how shiftReconciliation.ts uses it).
enum ShiftReconciliationStatus {
  PENDING // X-Report not in yet, or shift has no entries yet — never alerts
  OK
  VARIANCE
  RESOLVED
}

// The full provenance chain for one shift's X-Report reconciliation: what
// the till originally reported, what staff's entered figures actually sum
// to, and — if a variance needed a human — what an admin corrected it to
// and why. Never overwrites the till original; an admin edit is an
// approved adjustment recorded alongside it, not a replacement.
model ShiftReconciliation {
  shiftReconciliationId Int      @id @default(autoincrement())
  date                  DateTime @db.Date
  shift                 Shift

  // The till's own report, immutable — refreshed from TillReport, never
  // hand-edited.
  originalTotal Decimal? @db.Decimal(18, 2)
  xReportCount  Int      @default(0) // >1 = reprint/duplicate X-Report

  // What staff's entered figures for this shift actually sum to (via
  // computeShiftTotals), attributed via whichever DailySummary row was last
  // saved for this (date, shift) — not a separately hand-typed value.
  staffEnteredTotal  Decimal?  @db.Decimal(18, 2)
  staffEnteredById   Int?
  staffEnteredByName String?
  staffEnteredAt     DateTime?

  // An admin's reviewed, approved correction — set only via the admin edit
  // endpoint, and only that endpoint. A reason is required by the API
  // whenever a value is actually being changed.
  adminEditedTotal  Decimal?  @db.Decimal(18, 2)
  adminEditedById   Int?
  adminEditedByName String?
  adminEditedAt     DateTime?
  adminEditReason   String?

  // Derived, persisted rather than recomputed on every read so "before" and
  // "after" render without re-deriving history:
  //   finalTotal         = adminEditedTotal ?? staffEnteredTotal ?? originalTotal
  //   originalDifference = originalTotal − staffEnteredTotal
  //   finalDifference    = originalTotal − finalTotal
  finalTotal         Decimal? @db.Decimal(18, 2)
  originalDifference Decimal? @db.Decimal(18, 2)
  finalDifference    Decimal? @db.Decimal(18, 2)

  originalStatus ShiftReconciliationStatus @default(PENDING)
  finalStatus    ShiftReconciliationStatus @default(PENDING)

  // Is there any staff entry at all for this (date, shift)? Guards
  // evaluateAndNotify from alerting on a shift nobody has touched yet.
  hasEntries Boolean @default(false)

  // De-dupe: only re-notify when the difference has actually moved by more
  // than tolerance since the last email, so the poller doesn't re-mail an
  // unchanged variance every cycle.
  notifiedAt         DateTime?
  notifiedDifference Decimal?  @db.Decimal(18, 2)

  // Staff sign-off for THIS shift, distinct from the day-level commit on
  // ReconciliationRecord. A shift is validated against its own X-Report, which
  // lands at the end of that shift — so this deliberately has no Z-Report gate.
  // The day commit keeps its Z gate and remains the final step.
  //
  // Written ONLY by POST /Summary/shift-commit. evaluateShift must never touch
  // these columns, for the same reason it never touches the admin columns: a
  // poller cycle or a staff re-save would otherwise silently un-commit a shift.
  isShiftCommitted       Boolean   @default(false)
  shiftCommittedByUserId Int?
  shiftCommittedByName   String?
  shiftCommittedAt       DateTime?
  shiftStaffNotes        String?

  // Admin safety valve for the Day→Night prior-shift gate (see
  // forceUnlockNightShift in lib/shiftReconciliation.ts): set ONLY when an
  // admin force-unlocks Night without a genuine Day staff commit. These stay
  // null on a genuine staff commit, and shiftCommittedByName etc. stay null
  // on a forced row — the two must never be confused by column inspection
  // alone. The reason is never shown to staff (see toStaffShiftDto).
  forcedUnlockByUserId Int?
  forcedUnlockByName   String?
  forcedUnlockAt       DateTime?
  forcedUnlockReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([date, shift])
  @@index([finalStatus])
}

// Represents "no shift was expected here" — a holiday or other planned store
// closure — for one (date, shift). A whole-day closure is modelled as TWO
// rows (one DAY, one NIGHT), created together by the "Close whole day" admin
// action, so every reader only ever asks "is (date, shift) closed" for a
// concrete DAY/NIGHT; shift is therefore NON-nullable with @@unique([date,
// shift]) rather than a nullable shift column — Postgres treats each NULL as
// distinct in a unique index, so a nullable column would not actually
// prevent duplicate whole-day-closure rows.
//
// Only current state + latest transition lives here (same "cache latest
// value" pattern as ShiftReconciliation.adminEdited*/forcedUnlock*); full
// history lives in AuditLog like every other admin action in this app.
model StoreClosure {
  storeClosureId Int      @id @default(autoincrement())
  date           DateTime @db.Date
  // DAY or NIGHT only, never FULL_DAY — see the model doc comment above.
  shift          Shift
  reason         String
  active         Boolean  @default(true)

  closedByUserId Int
  closedByName   String?
  closedAt       DateTime @default(now())

  reopenedByUserId Int?
  reopenedByName   String?
  reopenedAt       DateTime?
  reopenReason     String?

  @@unique([date, shift])
  @@index([date])
}

model ActiveDateOverride {
  id          Int       @id @default(1)
  activeDate  DateTime? @db.Date
  // null = derive the active shift from the wall clock against
  // SHIFT_CUTOFF_TIME (see lib/activeDate.ts's classifyShift). Set to force
  // a specific shift regardless of the time — e.g. night staff still
  // finishing entries after the cutoff has rolled into the next shift.
  activeShift Shift?
  setAt       DateTime?
}

// FULL_DAY is the legacy/unassigned bucket. Every entry-table row that
// existed before the two-shift feature carries it, and it stays the column
// default forever — not a one-off backfill value — so that any write path
// that hasn't been made shift-aware yet lands somewhere countable rather
// than silently corrupting a shift's figures. computeDailyTotals() sums all
// three, so a FULL_DAY row contributes to the day exactly as it always did.
enum Shift {
  FULL_DAY
  DAY
  NIGHT
}

enum TillReportType {
  X_REPORT
  Z_REPORT
}

// One row per till report EMAIL (X-Report or Z-Report), persisted so
// reconciliation stops making a live Gmail round-trip on every request.
// Write-once — an admin correction never mutates this table (see
// ShiftReconciliation.adminEditedTotal); this table is the immutable record
// of what the till itself sent.
model TillReport {
  tillReportId Int @id @default(autoincrement())

  // True idempotency key — re-ingesting the same inbox is a no-op.
  gmailMessageId String @unique

  reportType TillReportType

  // The report's OWN "Date:" field (via tillReportParser.ts), NOT the
  // email's received date — the two have been observed to differ by more
  // than a day in real emails from this sender.
  businessDate DateTime @db.Date

  // businessDate + the report's own "Time:" field — shop-local wall clock as
  // printed on the till slip. This, not the email's received timestamp, is
  // what shift classification against SHIFT_CUTOFF_TIME must use.
  printedAt      DateTime
  printedMinutes Int
  shift          Shift

  // "Z10409" for a Z-Report, or "1001" for an S-Report-style X-Report (its
  // "S-REPORT ID : N" marker — see tillReportParser.ts's REPORT_TYPE_MARKER_RE
  // and resolveReportType, S-Reports are stored as reportType X_REPORT). The
  // classic bare "X-REPORT" marker carries no id, so this stays null there.
  reportRef String?

  departmentTotal Decimal? @db.Decimal(18, 2)
  grandTotal      Decimal? @db.Decimal(18, 2)
  cashTotal       Decimal? @db.Decimal(18, 2)
  cardTotal       Decimal? @db.Decimal(18, 2)
  manualCardTotal Decimal? @db.Decimal(18, 2)

  // From the "No of Transactions : N" line. Nullable/best-effort like every
  // other field added in this phase — a report that fails to yield this must
  // still ingest for its existing fields (see tillReportParser.ts).
  transactionCount Int?

  // Sum shown on the report's own "Income / Expense TOTAL" line. The
  // individual labelled lines behind it (e.g. "LOTTERY PO") live on
  // incomeExpenseLines below — kept separately so a human/later phase can see
  // both the aggregate the till printed and what made it up.
  incomeExpenseTotal Decimal? @db.Decimal(18, 2)

  emailReceivedAt DateTime
  emailSubject    String
  rawBody         String

  // Non-fatal parse notes (see tillReportParser.ts's ParsedTillReport.parseError)
  // preserved alongside the parsed fields rather than discarded, so a human
  // reviewing ingested data can see e.g. a header/Date: field disagreement
  // that was resolved automatically.
  parseNotes String?

  createdAt DateTime @default(now())

  // Additive child rows for the detailed sections of the report (department
  // lines, VAT breakdown, income/expense lines, refunds/voids, product
  // sales/stock). All optional in practice — see tillReportParser.ts — a
  // report that fails to yield any of these simply gets zero child rows,
  // never a hard ingestion failure.
  departmentLines    TillReportDepartmentLine[]
  vatLines           TillReportVatLine[]
  incomeExpenseLines TillReportIncomeExpenseLine[]
  voidLines          TillReportVoidLine[]
  productLines       TillReportProductLine[]

  // Deliberately NO @@unique on (businessDate, reportType, shift) — a
  // till reprint must not throw on ingestion. Duplicates are surfaced via
  // count queries in tillReportIngest.ts instead.
  @@index([businessDate, reportType])
  @@index([businessDate, reportType, shift])
}

// One row per "DEPARTMENT SALES" line on a till report (e.g. "ALCOHOL
// 305.05"). The real report groups these into two blocks, each closed by its
// own "SUB TOTAL" line: ordinary merchandise departments, then a second block
// of INSTANT LOTTERY / LOTTERY / PAYPOINT. `category` preserves that split
// since those three are not merchandise and later reconciliation phases will
// almost certainly want to treat them separately (they already are,
// elsewhere in this app, via LotteryRecord/PaypointRecord/ScratchCard).
model TillReportDepartmentLine {
  tillReportDepartmentLineId Int @id @default(autoincrement())

  tillReportId   Int
  departmentName String
  amount         Decimal                       @db.Decimal(18, 2)
  category       TillReportDepartmentCategory @default(MERCHANDISE)

  tillReport TillReport @relation(fields: [tillReportId], references: [tillReportId], onDelete: Cascade)

  @@index([tillReportId])
}

enum TillReportDepartmentCategory {
  MERCHANDISE
  LOTTERY_GROUP
}

// One row per "VAT BREAKDOWN" line (e.g. "20.00   807.26   161.45   968.71").
// vatCode is text, NOT numeric/Decimal — the till prints a literal "Exmt" row
// alongside the numeric-rate rows ("0.00", "20.00"), and forcing that into a
// number would either crash or silently lose the exempt row.
model TillReportVatLine {
  tillReportVatLineId Int @id @default(autoincrement())

  tillReportId Int
  vatCode      String // "0.00" | "20.00" | "Exmt" — verbatim from the report
  salesExVat   Decimal @db.Decimal(18, 2)
  vat          Decimal @db.Decimal(18, 2)
  salesInVat   Decimal @db.Decimal(18, 2)

  tillReport TillReport @relation(fields: [tillReportId], references: [tillReportId], onDelete: Cascade)

  @@index([tillReportId])
}

// One row per "INCOME / EXPENSE" line (e.g. "LOTTERY PO   -3.00"). Only one
// has ever been observed on a real report, but the section is a list on the
// till's own printout, so this is modelled as one rather than assuming it
// will always stay singular. The aggregate the till prints alongside these
// ("Income / Expense TOTAL") is stored on TillReport.incomeExpenseTotal.
model TillReportIncomeExpenseLine {
  tillReportIncomeExpenseLineId Int @id @default(autoincrement())

  tillReportId Int
  label        String
  amount       Decimal @db.Decimal(18, 2)

  tillReport TillReport @relation(fields: [tillReportId], references: [tillReportId], onDelete: Cascade)

  @@index([tillReportId])
}

// One row per "REFUNDS / VOIDS BREAKDOWN" line (e.g. "Voided - 01
// 12/08/2026 11:43:00   1.99"). `type` is stored verbatim ("Drawer - 01",
// "Voided - 02", ...) rather than split into a code + number — the spec for
// this phase is explicit that it should not be parsed further, since it's
// unclear yet whether "Drawer" and "Voided" need different handling in a
// later reconciliation phase.
model TillReportVoidLine {
  tillReportVoidLineId Int @id @default(autoincrement())

  tillReportId Int
  type         String // "Drawer - 01" | "Voided - 03" — verbatim
  // Date + Time as printed on this specific line (not businessDate/printedAt
  // — a void can in principle be logged against a different day than the
  // report's own header, e.g. near a shift boundary).
  occurredAt DateTime
  amount     Decimal  @db.Decimal(18, 2)

  tillReport TillReport @relation(fields: [tillReportId], references: [tillReportId], onDelete: Cascade)

  @@index([tillReportId])
}

// One row per product line under "SALES AND INVENTORY DETAILS" (e.g. "1664
// BIERE   1   -6"). departmentName is the bare header line the till prints
// above each block of products (e.g. "ALCOHOL"). productName is stored
// EXACTLY as printed, including any encoding artifacts from the till's own
// software — normalising it for matching purposes is explicitly a later
// phase's job, not this one's.
model TillReportProductLine {
  tillReportProductLineId Int @id @default(autoincrement())

  tillReportId   Int
  departmentName String
  productName    String
  salesQuantity  Int

  // Null means the till printed the literal "N/A" — i.e. stock is genuinely
  // unknown for this product, not zero and not some other sentinel. Kept
  // alongside the explicit stockUnavailable flag below so a query never has
  // to guess whether a null came from "N/A" or from some future parse gap.
  stockValue       Int?
  stockUnavailable Boolean @default(false)

  tillReport TillReport @relation(fields: [tillReportId], references: [tillReportId], onDelete: Cascade)

  @@index([tillReportId])
}

model GmailConnection {
  gmailConnectionId    Int       @id @default(autoincrement())
  emailAddress         String
  refreshToken         String
  accessToken          String?
  accessTokenExpiresAt DateTime?
  isActive             Boolean   @default(true)
  connectedAt          DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  connectedByUserId Int
  connectedByUser   User @relation(fields: [connectedByUserId], references: [userId])
}

// Photographic evidence attached to one entry session. The "session" here is
// the same (date, shift) pair every other entry model is keyed by — resolved
// server-side from getActiveContext(), never taken from the client, so a
// photo can't be filed against a session the uploader isn't actually working.
//
// Only metadata lives here. The bytes live behind the storage driver
// (lib/storage), addressed by storageKey — a driver-relative key, not a
// filesystem path, so moving to S3/R2 is a driver swap and not a schema
// change. Nothing in this table is safe to build a public URL from.
model SessionPhoto {
  sessionPhotoId Int @id @default(autoincrement())

  section  String
  date     DateTime @db.Date
  shift    Shift    @default(FULL_DAY)
  // Set only for catalogue-style sections (Scratch Cards), where a photo
  // belongs to a thing rather than to a day. Null for the daily pages.
  entityId String?

  uploadedByUserId Int
  uploadedByName   String?

  // Kept for display and audit only. Never used to build a path — the file
  // on disk is named from storageKey, which the server generates.
  originalFilename String
  storageKey       String  @unique
  thumbnailKey     String?
  mimeType         String
  fileSize         Int
  width            Int?
  height           Int?
  source           String  @default("file") // "camera" | "file"
  status           String  @default("ready") // "ready" | "failed"

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([uploadedByUserId])
  @@index([date, shift])
  @@index([section, date, shift])
