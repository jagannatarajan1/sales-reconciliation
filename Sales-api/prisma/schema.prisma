generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId       Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("user") // user or admin
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  isActive     Boolean  @default(true)

  orders           Order[]
  gmailConnections GmailConnection[]
}

model Order {
  orderId     Int      @id @default(autoincrement())
  userId      Int
  orderNumber String
  orderDate   DateTime
  totalAmount Decimal  @db.Decimal(18, 2)
  status      String   @default("pending") // pending, completed, cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [userId])
}

model DailySummary {
  dailySummaryId Int      @id @default(autoincrement())
  date           DateTime @unique @db.Date

  cashback             Decimal @default(0) @db.Decimal(18, 2)
  paypointPayout       Decimal @default(0) @db.Decimal(18, 2)
  instantLotteryPayout Decimal @default(0) @db.Decimal(18, 2)
  lotteryPayout        Decimal @default(0) @db.Decimal(18, 2)
  newsVoucher          Decimal @default(0) @db.Decimal(18, 2)
  ddPoint              Decimal @default(0) @db.Decimal(18, 2)
  lotteryValue         Decimal @default(0) @db.Decimal(18, 2)
  paypointValue        Decimal @default(0) @db.Decimal(18, 2)
  lastSafe             Decimal @default(0) @db.Decimal(18, 2)
  safeDropAmount       Decimal @default(0) @db.Decimal(18, 2)

  isCommitted          Boolean @default(false)
  isPendingAdminReview Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  creditCardEntries CreditCardEntry[]
}

model CreditCardEntry {
  creditCardEntryId Int      @id @default(autoincrement())
  manualCardAmount  Decimal  @default(0) @db.Decimal(18, 2)
  cardAmount        Decimal  @default(0) @db.Decimal(18, 2)
  createdDate       DateTime @default(now())

  dailySummaryId Int
  dailySummary   DailySummary @relation(fields: [dailySummaryId], references: [dailySummaryId], onDelete: Cascade)
}

model GmailConnection {
  gmailConnectionId    Int       @id @default(autoincrement())
  emailAddress         String
  refreshToken         String
  accessToken          String?
  accessTokenExpiresAt DateTime?
  isActive             Boolean   @default(true)
  connectedAt          DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  connectedByUserId Int
  connectedByUser   User @relation(fields: [connectedByUserId], references: [userId])
}
